<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<title>Resumen semanal IA — {{ today }}</title>
</head>
<body style="margin:0;padding:0;background:#0a0a1a;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;color:#e0e0e0;">
<table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="background:#0a0a1a;">
  <tr><td align="center" style="padding:24px 12px;">
    <table role="presentation" width="640" cellspacing="0" cellpadding="0" border="0" style="max-width:640px;width:100%;">

      <tr><td style="background:linear-gradient(135deg,#1a1a3e,#0d0d2b);border-radius:12px 12px 0 0;padding:24px;border:1px solid #2d2d5e;border-bottom:none;">
        <div style="font-size:12px;letter-spacing:1px;color:#60a5fa;text-transform:uppercase;font-weight:600;margin-bottom:6px;">Resumen semanal IA</div>
        <div style="font-size:22px;color:#fff;font-weight:700;line-height:1.3;">{{ since_date }} → {{ today }}</div>
        <div style="font-size:13px;color:#94a3b8;margin-top:8px;">{{ total_items }} novedades · {{ categories|length }} categorías</div>
      </td></tr>

      {% if highlights %}
      <tr><td style="background:#0f172a;padding:20px 24px;border-left:1px solid #2d2d5e;border-right:1px solid #2d2d5e;">
        <div style="font-size:11px;letter-spacing:1.2px;color:#fbbf24;text-transform:uppercase;font-weight:700;margin-bottom:12px;">⭐ Top de la semana</div>
        {% for item in highlights %}
        <div style="margin-bottom:14px;padding-bottom:14px;{% if not loop.last %}border-bottom:1px solid #1e293b;{% endif %}">
          <a href="{{ item.url }}" style="color:#fff;font-size:15px;font-weight:600;text-decoration:none;line-height:1.4;">{{ item.title }}</a>
          <div style="font-size:12px;color:#94a3b8;margin-top:4px;">{{ item.organization }} · {{ item.published_date }}</div>
          <div style="font-size:13px;color:#cbd5e1;margin-top:6px;line-height:1.5;">{{ item.why_it_matters_es }}</div>
        </div>
        {% endfor %}
      </td></tr>
      {% endif %}

      {% for cat_id, cat_label, cat_items in sections %}
      <tr><td style="background:#12122a;padding:20px 24px;border-left:1px solid #2d2d5e;border-right:1px solid #2d2d5e;">
        <div style="font-size:11px;letter-spacing:1.2px;color:#60a5fa;text-transform:uppercase;font-weight:700;margin-bottom:14px;border-bottom:1px solid #2d2d5e;padding-bottom:8px;">{{ cat_label }} ({{ cat_items|length }})</div>
        {% for item in cat_items %}
        <div style="margin-bottom:16px;{% if not loop.last %}padding-bottom:16px;border-bottom:1px solid #1e1e3e;{% endif %}">
          <div style="display:inline-block;background:rgba(59,130,246,.15);color:#60a5fa;font-size:10px;font-weight:700;padding:2px 8px;border-radius:10px;letter-spacing:.5px;text-transform:uppercase;margin-bottom:8px;">★ {{ item.importance }}/5</div>
          <a href="{{ item.url }}" style="display:block;color:#fff;font-size:15px;font-weight:600;text-decoration:none;line-height:1.4;margin-bottom:4px;">{{ item.title }}</a>
          <div style="font-size:12px;color:#94a3b8;margin-bottom:8px;">{{ item.organization }} · {{ item.published_date }}</div>
          <div style="font-size:13px;color:#cbd5e1;line-height:1.55;">{{ item.summary_es }}</div>
          <div style="font-size:12px;color:#94a3b8;line-height:1.5;margin-top:6px;font-style:italic;">{{ item.why_it_matters_es }}</div>
        </div>
        {% endfor %}
      </td></tr>
      {% endfor %}

      <tr><td style="background:#0d0d2b;border-radius:0 0 12px 12px;padding:18px 24px;border:1px solid #2d2d5e;border-top:none;font-size:11px;color:#64748b;line-height:1.6;">
        Generado por <strong style="color:#94a3b8;">ai-news-agent</strong> el {{ generated_at }}.<br>
        Fuentes: laboratorios académicos, big tech, arXiv/Hugging Face y medios especializados.
      </td></tr>

    </table>
  </td></tr>
</table>
</body>
</html>
